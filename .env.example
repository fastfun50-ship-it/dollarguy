# DollarGuy M1 — copy to .env.local (never commit secrets)
# Default without keys: EXAMPLE mode (synthetic tickers only).

# Market-data vendor (NOT broker). example | alpaca | massive
DATA_PROVIDER=example
# FORCE_EXAMPLE=1

# --- Alpaca Basic (Paper account keys work for market data) ---
# Markedsdata-host er ALTID data.alpaca.markets (IKKE paper-api — det er trading).
# Preview: sæt keys i Vercel Preview env. Ingen NEXT_PUBLIC_*.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# Optional override (default https://data.alpaca.markets). paper-api URL is ignored.
# ALPACA_DATA_URL=https://data.alpaca.markets

# Massive / Polygon (optional alternative — adapter pending)
# MASSIVE_API_KEY=
# POLYGON_API_KEY=

# Database (optional — alarmhistorik falls back to memory)
# DATABASE_URL=
